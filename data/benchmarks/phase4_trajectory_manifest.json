{
  "manifest_version": "phase4_v1",
  "description": "Phase 4 field-space trajectory benchmark: persistent track state, multi-frame trajectories, camera-motion interaction, smoothing, velocity/acceleration, jump rejection, uncertainty propagation, and explicit calibrated/propagated/unknown geometry states across frozen TRAIN / VAL / TEST splits.",
  "benchmark_provenance_and_semantics": {
    "player_motion": "Synthetic deterministic field-space routes (straight lines, tanh-blended cuts, speed ramps). Timings, speeds and jitter are engineering fixtures, NOT recorded NFL player trajectories.",
    "footpoints": "Box fixtures generated by projecting the synthetic field-space ground truth through the real per-frame broadcast/All-22 homography of the base images, plus deterministic pixel jitter. FixturePlayerDetector (fixture_detector_v1) supplies the boxes.",
    "geometry": "Per-frame CalibrationResult objects: real Phase-1 calibrations of the base frames for calibrated frames; explicit failure objects for unknown frames; T(drift) composed variants flagged is_temporally_propagated for propagated frames.",
    "image_detector_accuracy": "UNMEASURED. Phase 4 measures the trajectory layer given projected player positions; it is not evidence that image-based player detection is solved.",
    "team_labels": "TEAM_A / TEAM_B remain permutation-invariant appearance clusters; trajectory metrics do not depend on real-world team identity.",
    "camera_cut": "Camera cuts are modelled as an abrupt synthetic framing change plus explicit calibration refusal objects (failure_reason='camera_cut_uncalibrated'). Real broadcast cuts also change scene content, exposure and motion blur, which are not modelled: this scenario validates the refusal/recovery state machine, not real cut detection accuracy."
  },
  "split_protocol": {
    "train": "Used to confirm the a priori gate/process-noise assumptions produce stable kinematics.",
    "val": "Used to check jump-rejection behaviour and camera-motion handling.",
    "test": "Strictly held-out frozen split; zero thresholds or model constants tuned on TEST."
  },
  "frozen_parameters": {
    "process_accel_std_yd_s2": 5.0,
    "gate_chi2_2dof": 9.21,
    "max_speed_yd_s": 12.0,
    "max_accel_yd_s2": 25.0,
    "max_gap_frames": 3,
    "max_consecutive_rejections": 3,
    "propagated_drift_yd_per_age": 0.25,
    "footpoint_edge_sigma_px": 1.0,
    "footpoint_sigma_floor_px": 0.3,
    "image_jump_max_speed_px_per_frame": 22.0,
    "note": "All constants were fixed a priori (documented engineering assumptions) before TEST was evaluated.",
    "camera_cut_refusal_frames": 3
  },
